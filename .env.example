# Required connector selection and Kafka connection.
TRUSTDECK_OPERATION=
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=
KAFKA_GROUP_ID=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=SASL_SSL
KAFKA_SASL_MECHANISM=PLAIN
KAFKA_TRUSTSTORE_LOCATION=
KAFKA_TRUSTSTORE_PASSWORD=
KAFKA_TRUSTSTORE_TYPE=JKS

# TrustDeck service account and resource targets.
TRUSTDECK_SERVICE_URL=
KEYCLOAK_TOKEN_ENDPOINT=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
TRUSTDECK_PROJECT=
TRUSTDECK_ENTITY_TYPE=
TRUSTDECK_DOMAIN=

# Optional mappings. Values are JSON Pointers or bare top-level names.
KAFKA_MESSAGE_IDENTIFIER_DESCRIPTOR=
KAFKA_MESSAGE_IDTYPE_DESCRIPTOR=
KAFKA_MESSAGE_PSN_DESCRIPTOR=
KAFKA_MESSAGE_SOURCE_SYSTEM_DESCRIPTOR=
KAFKA_MESSAGE_VALID_FROM_DESCRIPTOR=
KAFKA_MESSAGE_VALID_TO_DESCRIPTOR=
KAFKA_MESSAGE_USERNAME_DESCRIPTOR=
KAFKA_MESSAGE_ENTITY_TYPE_DESCRIPTOR=
KAFKA_MESSAGE_ENTITY_ID_DESCRIPTOR=
MAPPING_SOURCE_TIMEZONE=UTC
MAPPING_DATETIME_FORMAT=

# Optional SMTP. Empty SMTP_TO disables email.
SMTP_HOST=
SMTP_PORT=25
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_SSL_ENABLE=false
SMTP_FROM=trustdeck-kafka-connector@localhost
SMTP_TO=
SUBJECT_PREFIX=[TrustDeck Kafka Connector]
